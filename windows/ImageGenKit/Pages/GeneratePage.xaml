<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ImageGenKit.Pages.GeneratePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="36,0,36,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer>
            <StackPanel x:Name="Body" Spacing="16" MaxWidth="1040" Padding="0,0,0,8" />
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,12" MaxWidth="1040">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing x:Name="Spinner" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                    <ProgressBar x:Name="Progress" Width="140" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Stop" Visibility="Collapsed" Click="Cancel_Click" Height="36" />
                <Button x:Name="RunButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="Run_Click" MinWidth="150" Height="36"
                        ToolTipService.ToolTip="Generate (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" VerticalAlignment="Center" Data="M7,0 L8.4,5.6 L14,7 L8.4,8.4 L7,14 L5.6,8.4 L0,7 L5.6,5.6 Z" />
                        <TextBlock x:Name="RunText" Text="Generate" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Enter" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
