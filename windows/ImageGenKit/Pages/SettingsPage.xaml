<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ImageGenKit.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="28,0,36,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <SelectorBar x:Name="Sections" SelectionChanged="Sections_SelectionChanged">
            <SelectorBarItem Text="Providers" Tag="providers" />
            <SelectorBarItem Text="Use for" Tag="use" />
            <SelectorBarItem Text="On this PC" Tag="local" />
            <SelectorBarItem Text="Limits" Tag="limits" />
            <SelectorBarItem Text="AI agents" Tag="agents" />
            <SelectorBarItem Text="General" Tag="general" />
        </SelectorBar>
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1000" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Body" Spacing="6" Padding="8,4,0,36" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
