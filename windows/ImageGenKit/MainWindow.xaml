<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ImageGenKit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ImageGenKit">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="44" Padding="18,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock Text="ImageGenKit" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="232"
                        IsTitleBarAutoPaddingEnabled="False" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentMargin">0,0,0,0</Thickness>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF0E2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Gallery" Tag="gallery">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE91B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Padding="12,8,12,14" Spacing="10">
                    <Button x:Name="GenerateButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                            Height="36" Click="GenerateButton_Click" ToolTipService.ToolTip="Generate an image (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="14" Height="14" VerticalAlignment="Center"
                                      Data="M7,0 L8.4,5.6 L14,7 L8.4,8.4 L7,14 L5.6,8.4 L0,7 L5.6,5.6 Z" />
                            <TextBlock Text="Generate" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                        <Ellipse x:Name="ReadyDot" Width="6" Height="6" VerticalAlignment="Center" Fill="#34C759" />
                        <TextBlock x:Name="ReadyText" FontSize="12" Text=" " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="Header" Padding="36,6,36,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="Overview" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="HeaderSub" Text="" FontSize="13" Margin="0,1,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="Filters" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ComboBox x:Name="ProviderFilter" MinWidth="150" SelectionChanged="Filter_Changed" />
                        <ComboBox x:Name="RangeFilter" MinWidth="120" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="7 days" Tag="7" />
                            <ComboBoxItem Content="30 days" Tag="30" />
                            <ComboBoxItem Content="90 days" Tag="90" />
                            <ComboBoxItem Content="12 months" Tag="365" />
                            <ComboBoxItem Content="All time" Tag="0" />
                        </ComboBox>
                        <AutoSuggestBox x:Name="SearchBox" Width="220" PlaceholderText="Search prompts"
                                        QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
                    </StackPanel>
                </Grid>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
                <InfoBar x:Name="ErrorBar" Grid.Row="1" IsOpen="False" Severity="Error" VerticalAlignment="Bottom"
                         Margin="36,0,36,20" IsClosable="True" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
