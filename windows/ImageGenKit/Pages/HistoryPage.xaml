<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ImageGenKit.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ImageGenKit.Pages"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="HeadText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <DataTemplate x:Key="WideRow" x:DataType="local:HistoryRow">
            <Grid Height="56" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Style="{StaticResource TileStyle}" VerticalAlignment="Center">
                    <Image Source="{x:Bind Thumb}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Grid.Column="1" Text="{x:Bind Date}" Style="{StaticResource CellText}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{x:Bind Dot}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Provider}" Style="{StaticResource CellText}" />
                </StackPanel>
                <Border Grid.Column="3" Style="{StaticResource PillStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Kind}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <TextBlock Grid.Column="4" Text="{x:Bind Model}" Style="{StaticResource CellText}" />
                <TextBlock Grid.Column="5" Text="{x:Bind Images}" Style="{StaticResource CellText}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="6" Text="{x:Bind Size}" Style="{StaticResource CellText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="7" Text="{x:Bind Cost}" Style="{StaticResource CellText}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="8" Text="{x:Bind Time}" Style="{StaticResource CellText}" HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CompactRow" x:DataType="local:HistoryRow">
            <Grid Height="56" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" MinWidth="100" />
                    <ColumnDefinition Width="62" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Style="{StaticResource TileStyle}" VerticalAlignment="Center">
                    <Image Source="{x:Bind Thumb}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Grid.Column="1" Text="{x:Bind Date}" Style="{StaticResource CellText}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{x:Bind Dot}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Provider}" Style="{StaticResource CellText}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{x:Bind Model}" Style="{StaticResource CellText}" />
                <TextBlock Grid.Column="4" Text="{x:Bind Cost}" Style="{StaticResource CellText}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="TableHost" Margin="36,0,20,24" SizeChanged="TableHost_SizeChanged">
            <Border Style="{StaticResource CardStyle}" Padding="0" />
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="Table" MinWidth="880">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="WideHead" Padding="22,12,16,10" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Date" Style="{StaticResource HeadText}" />
                        <TextBlock Grid.Column="2" Text="Provider" Style="{StaticResource HeadText}" />
                        <TextBlock Grid.Column="3" Text="Type" Style="{StaticResource HeadText}" />
                        <TextBlock Grid.Column="4" Text="Model" Style="{StaticResource HeadText}" />
                        <TextBlock Grid.Column="5" Text="Images" Style="{StaticResource HeadText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="Size" Style="{StaticResource HeadText}" />
                        <TextBlock Grid.Column="7" Text="Cost" Style="{StaticResource HeadText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="8" Text="Time" Style="{StaticResource HeadText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid x:Name="CompactHead" Visibility="Collapsed" Padding="22,12,16,10" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" MinWidth="100" />
                            <ColumnDefinition Width="62" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Date" Style="{StaticResource HeadText}" />
                        <TextBlock Grid.Column="2" Text="Provider" Style="{StaticResource HeadText}" />
                        <TextBlock Grid.Column="3" Text="Model" Style="{StaticResource HeadText}" />
                        <TextBlock Grid.Column="4" Text="Cost" Style="{StaticResource HeadText}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView x:Name="Rows" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Rows_ItemClick"
                              Padding="4,4,4,8" ItemTemplate="{StaticResource WideRow}" />
                </Grid>
            </ScrollViewer>
            <TextBlock x:Name="Empty" Text="Nothing here yet." Visibility="Collapsed" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Border x:Name="InspectorHost" Grid.Column="1" BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource CardStrokeBrush}" Background="{ThemeResource HeroBrush}" />
    </Grid>
</Page>
