<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ImageGenKit.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Graphite: black accent in light mode, white in dark mode (like the Mac app). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#1C1C1E</Color>
                    <Color x:Key="SystemAccentColorDark1">#1C1C1E</Color>
                    <Color x:Key="SystemAccentColorDark2">#2C2C2E</Color>
                    <Color x:Key="SystemAccentColorDark3">#3A3A3C</Color>
                    <Color x:Key="SystemAccentColorLight1">#3A3A3C</Color>
                    <Color x:Key="SystemAccentColorLight2">#48484A</Color>
                    <Color x:Key="SystemAccentColorLight3">#636366</Color>
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" Opacity="0.72" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#000000" Opacity="0.06" />
                    <SolidColorBrush x:Key="WellBrush" Color="#000000" Opacity="0.045" />
                    <SolidColorBrush x:Key="HeroBrush" Color="#FFFFFF" Opacity="0.55" />
                    <SolidColorBrush x:Key="GridLineBrush" Color="#000000" Opacity="0.07" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#F2F2F7</Color>
                    <Color x:Key="SystemAccentColorDark1">#E5E5EA</Color>
                    <Color x:Key="SystemAccentColorDark2">#D1D1D6</Color>
                    <Color x:Key="SystemAccentColorDark3">#C7C7CC</Color>
                    <Color x:Key="SystemAccentColorLight1">#F2F2F7</Color>
                    <Color x:Key="SystemAccentColorLight2">#F2F2F7</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFFFFF</Color>
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" Opacity="0.05" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#FFFFFF" Opacity="0.07" />
                    <SolidColorBrush x:Key="WellBrush" Color="#FFFFFF" Opacity="0.06" />
                    <SolidColorBrush x:Key="HeroBrush" Color="#FFFFFF" Opacity="0.035" />
                    <SolidColorBrush x:Key="GridLineBrush" Color="#FFFFFF" Opacity="0.07" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20,18" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="FaintTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="TrackStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WellBrush}" />
                <Setter Property="CornerRadius" Value="999" />
            </Style>
            <Style x:Key="GridLineStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource GridLineBrush}" />
                <Setter Property="Height" Value="1" />
            </Style>
            <Style x:Key="HeroStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource HeroBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
            <Style x:Key="TileStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WellBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="PillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WellBrush}" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="9,3" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
