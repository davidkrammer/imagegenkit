<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ImageGenKit.Pages.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ImageGenKit.Pages"
    Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <GridView x:Name="Tiles" Padding="36,0,20,36" SelectionMode="Single" IsItemClickEnabled="True"
                  ItemClick="Tiles_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:GalleryTile">
                    <Border Width="172" Height="172" CornerRadius="10" Style="{StaticResource TileStyle}"
                            ToolTipService.ToolTip="{x:Bind Tip}">
                        <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:DayGroup">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind CountText}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
        </GridView>
        <StackPanel x:Name="Empty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="No images here" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyHint" Text="" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Border x:Name="InspectorHost" Grid.Column="1" Margin="0,0,0,0" BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource CardStrokeBrush}" Background="{ThemeResource HeroBrush}" />
    </Grid>
</Page>
